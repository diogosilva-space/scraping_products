{
  "name": "scraping-products",
  "version": "2.0.0",
  "description": "Worker de scraping de catálogos → apps/api + DigitalOcean Spaces",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "scrape:spot": "tsx src/cli.ts --site spot",
    "scrape:xbz": "tsx src/cli.ts --site xbz",
    "scrape:somarcas": "tsx src/cli.ts --site somarcas",
    "scrape:neoplas": "tsx src/cli.ts --site neoplas",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "playwright:install": "tsx -e \"import { playwrightBrowsersPath } from './src/core/playwright-env.ts'; console.log('PLAYWRIGHT_BROWSERS_PATH='+playwrightBrowsersPath)\" && playwright install chromium",
    "cleanup": "chmod +x cleanup-emergency.sh && ./cleanup-emergency.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "p-limit": "^6.2.0",
    "playwright": "^1.52.0",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
